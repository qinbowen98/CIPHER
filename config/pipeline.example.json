{
  "private_output": "../private_runs/final_inference",
  "training": {
    "working_dir": "../data/private/training_assets",
    "gpu": "0",
    "data": {
      "soma_train": "../data/private/Soma_origin_replicate2.csv",
      "soma_valid": "../data/private/Soma_origin_shougang_validation.csv",
      "snp_prefix": "../data/private/filter_final_all",
      "fundus_dir": "../data/private/data_clean_new",
      "fundus_embed_dir": "../data/private/embeddings",
      "ecg_dir": "../data/private/CVD_all",
      "label_csv": "../data/private/CMCS_outcome_final.csv",
      "cmcs_standard_csv": "../data/private/CMCS_standard.csv",
      "soma_gene_csv": "../data/private/final_genelist_Cardio.csv"
    },
    "single": {
      "modalities": [
        "snp",
        "soma",
        "ecg",
        "fundus"
      ],
      "seeds": [
        42,
        66,
        100
      ],
      "arguments": {
        "epochs": 50,
        "grid_lr": [
          1e-05,
          0.0001
        ],
        "grid_bs": [
          16,
          32
        ],
        "soma_norm": "ranknorm",
        "endpoints": [
          "CHD",
          "ICVD",
          "CVDdeath",
          "stroke",
          "istroke",
          "hstroke",
          "ICVDr",
          "UA"
        ]
      }
    },
    "multi": {
      "combinations": [
        [
          "snp",
          "soma",
          "ecg",
          "fundus"
        ]
      ],
      "seeds": [
        42,
        66,
        100
      ],
      "arguments": {
        "epochs": 50,
        "batch_size": 64,
        "save_ig": false,
        "endpoints": [
          "CHD",
          "istroke",
          "hstroke",
          "CVDdeath",
          "UA"
        ]
      }
    }
  },
  "inference": {
    "ukb": {
      "model_features": "../data/private/ukb_original_clinical_features.parquet",
      "score_features": "../data/private/ukb_enriched_score_features.parquet",
      "outcomes": "../data/private/ukb_outcomes.parquet",
      "id_column": "eid",
      "age_bands": [
        [
          40,
          74
        ],
        [
          60,
          74
        ]
      ],
      "bootstrap": 300,
      "jobs": 8,
      "seed": 20260923,
      "bootstrap_sort_ids": true,
      "expected_counts": {
        "40-74": {
          "n": 212176,
          "events": 21847
        },
        "60-74": {
          "n": 89646,
          "events": 13750
        }
      },
      "reference_predictions": null
    },
    "much": {
      "table": "../data/private/much_completed_features.csv",
      "id_column": "PATIENT_SN",
      "event_column": "ASCVD_EVENT",
      "time_column": "FOLLOWUP_YEARS",
      "bootstrap": 300,
      "jobs": 8,
      "seed": 20260923,
      "bootstrap_sort_ids": false,
      "reference_predictions": null
    }
  },
  "models": "../release"
}
